# Reown (WalletConnect) project id — get one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Data source: mock (default preview) | live (real chain reads/writes)
VITE_DATA_MODE=mock

# Optional HashKey Chain RPC override.
# The public RPC sends no CORS headers, so browser reads are blocked in live
# mode. For local dev, route through the built-in same-origin proxy instead:
#   VITE_HASHKEY_RPC=http://localhost:3000/hsk-rpc
# (proxied to https://mainnet.hsk.xyz by vite.config server.proxy). For a real
# deployment, point this at a CORS-enabled / API-keyed HashKey RPC.
# VITE_HASHKEY_RPC=https://mainnet.hsk.xyz
