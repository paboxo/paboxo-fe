# Reown (WalletConnect) project id — get one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Data source: mock (default preview) | live (real chain reads/writes)
VITE_DATA_MODE=mock

# HSP payment gateway: mock (default) | hsp (real on-chain HSP pay in USDC.e)
VITE_PAYMENT_MODE=mock
# HSP is LIVE on HashKey mainnet 177. `hsp` mode needs the creds below. Keep the
# REAL API key ONLY in .env.local (gitignored) — NEVER commit it here.
# VITE_HSP_COORDINATOR_URL=https://hsp-hackathon.hashkeymerchant.com
# VITE_HSP_CHAIN=hashkey            # mainnet 177 (default) | hashkey-testnet (133) to dry-run first
# Write-only sandbox key — Bearer for POST /payments + /observe. Demo-only: the
# production path proxies register+observe through a backend so the key never
# ships to the browser. Leave blank here; set the real value in .env.local.
# VITE_HSP_API_KEY=
# Adapter observation-signing address (pinned via GET /chains; default baked in).
# VITE_HSP_ADAPTER_ADDRESS=0x467AaF355DF243379B961Ce00abBae20c1e25012

# Live Ponder indexer. Absent → the mock indexer is used even in live mode.
# VITE_INDEXER_URL=https://hash.staifdev.codes/graphql

# Rebalance-agent activity feed (llmMessage + actions).
# Absent → the mock agent-activity fixture is used.
#
# What the app fetches (client-visible, so keep it a same-origin proxy PATH — no
# host, no secret). Relative path works on any host/port:
#   VITE_AGENT_API_URL=/agent-api
#
# The REAL upstream host is read by the dev server ONLY (never bundled to the
# browser, never hardcoded in vite.config). Put it in .env.local (gitignored):
#   AGENT_UPSTREAM=https://your-agent-api.example
# The /agent-api proxy is registered only when AGENT_UPSTREAM is set. For a real
# deployment, front it with an edge/backend proxy — the Vite proxy is dev-only.
# VITE_AGENT_API_URL=/agent-api

# Optional HashKey Chain RPC override.
# The public RPC sends no CORS headers, so browser reads are blocked in live
# mode. For local dev, route through the built-in same-origin proxy instead:
#   VITE_HASHKEY_RPC=http://localhost:3000/hsk-rpc
# (proxied to https://mainnet.hsk.xyz by vite.config server.proxy). For a real
# deployment, point this at a CORS-enabled / API-keyed HashKey RPC.
# VITE_HASHKEY_RPC=https://mainnet.hsk.xyz
